# Optional: set this to part of your microphone name if the default mic is wrong.
# TENKA_MICROPHONE_NAME=C-Media

# Piper offline TTS settings
# Install Piper so the `piper` command is available, or point PIPER_COMMAND to piper.exe.
# Example:
# PIPER_COMMAND=E:\Tenka-AI\tools\piper\piper.exe
PIPER_COMMAND=piper

# Point this to a Piper voice model file (.onnx).
# Example:
# PIPER_MODEL=E:\Tenka-AI\voices\en_US-lessac-medium.onnx
PIPER_MODEL=

# Optional for multi-speaker models.
# PIPER_SPEAKER_ID=0
